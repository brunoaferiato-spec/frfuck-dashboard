const eolPorNome = {};

function ler(file, nome) {
  if (!fs.existsSync(file)) falhar(`Arquivo não encontrado: ${file}`);
  const bruto = fs.readFileSync(file, "utf8");
  eolPorNome[nome] = bruto.includes("\r\n") ? "\r\n" : "\n";
  return bruto.replace(/\r\n/g, "\n");
}

function contar(texto, trecho) {
  return texto.split(trecho).length - 1;
}

function replaceOnce(texto, antigo, novo, rotulo) {
  const n = contar(texto, antigo);
  if (n !== 1) {
    falhar(
      `${rotulo}: esperava 1 ocorrência, encontrei ${n}. Nenhum arquivo foi gravado.`
    );
  }
  return texto.replace(antigo, novo);
}

function replaceCount(texto, antigo, novo, esperado, rotulo) {
  const n = contar(texto, antigo);
  if (n !== esperado) {
    falhar(
      `${rotulo}: esperava ${esperado} ocorrência(s), encontrei ${n}. Nenhum arquivo foi gravado.`
    );
  }
  return texto.split(antigo).join(novo);
}

function replaceRegexOnce(texto, regex, novo, rotulo) {
  const matches = [...texto.matchAll(regex)];
  if (matches.length !== 1) {
    falhar(
      `${rotulo}: esperava 1 ocorrência, encontrei ${matches.length}. Nenhum arquivo foi gravado.`
    );
  }
  return texto.replace(regex, novo);
}

function indiceN(texto, trecho, n) {
  let from = 0;
  let idx = -1;

  for (let i = 0; i < n; i++) {
    idx = texto.indexOf(trecho, from);

    if (idx < 0) return -1;

    from = idx + trecho.length;
  }

  return idx;
}

function inserirAntesIndice(texto, idx, conteudo) {
  return texto.slice(0, idx) + conteudo + texto.slice(idx);
}

function encontrarStatement(texto, needle) {
  const idx = texto.indexOf(needle);

  if (idx < 0) {
    falhar(`Não encontrei: ${needle}`);
  }

  const janelaInicio = Math.max(0, idx - 4000);
  const janela = texto.slice(janelaInicio, idx + needle.length);

  const candidatos = [
    ...janela.matchAll(/^[ \t]*const\s+([A-Za-z_$][\w$]*)\s*=/gm),
  ];

  if (!candidatos.length) {
    falhar(`Não consegui identificar a declaração que contém ${needle}`);
  }

  const ultimo = candidatos[candidatos.length - 1];
  const start = janelaInicio + Number(ultimo.index || 0);
  const varName = ultimo[1];

  let lineStart = start;
  let end = -1;

  while (lineStart < texto.length) {
    const nl = texto.indexOf("\n", lineStart);
    const lineEnd = nl < 0 ? texto.length : nl;
    const linha = texto.slice(lineStart, lineEnd).trim();

    if (linha.endsWith(");") || linha.endsWith(";")) {
      end = nl < 0 ? texto.length : nl + 1;
      break;
    }

    if (nl < 0) break;

    lineStart = nl + 1;

    if (lineStart - start > 10000) break;
  }

  if (end < 0) {
    falhar(`Não consegui encontrar o final da declaração ${varName}`);
  }

  return {
    start,
    end,
    varName,
  };
}

function encontrarChamadaObjeto(texto, needle, occurrence = 1) {
  const idx = indiceN(texto, needle, occurrence);

  if (idx < 0) {
    falhar(`Não encontrei a chamada ${needle} #${occurrence}`);
  }

  const abre = texto.indexOf("{", idx);

  if (abre < 0) {
    falhar(`Objeto da chamada ${needle} não encontrado`);
  }

  let depth = 0;
  let quote = null;
  let escaped = false;

  for (let i = abre; i < texto.length; i++) {
    const c = texto[i];

    if (quote) {
      if (escaped) {
        escaped = false;
      } else if (c === "\\") {
        escaped = true;
      } else if (c === quote) {
        quote = null;
      }

      continue;
    }

    if (c === '"' || c === "'" || c === "`") {
      quote = c;
      continue;
    }

    if (c === "{") {
      depth++;
    }

    if (c === "}") {
      depth--;

      if (depth === 0) {
        return {
          start: idx,
          objectStart: abre,
          objectEnd: i,
        };
      }
    }
  }

  falhar(`Não consegui fechar o objeto da chamada ${needle}`);
}

